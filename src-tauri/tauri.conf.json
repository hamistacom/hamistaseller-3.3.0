{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hamista Seller",
  "version": "3.3.0",
  "identifier": "ir.hamista.seller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "هامیستا سلر",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "backgroundColor": "#F4F5F7"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data: https:; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Hamista Creative Agency",
    "copyright": "© Hamista — hamista.ir"
  }
}
